# Copy to backend/.env for local development (never commit the real .env).

# development | production   (production refuses unsafe settings)
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (Neon, Supabase, Render and Railway URLs work; postgres:// is accepted).
# Required in production. The value below matches the local container in the README.
DATABASE_URL=postgresql+psycopg://driftwear:driftwear@localhost:5432/driftwear
DB_POOL_SIZE=5
# Only for SQLite/tests. With PostgreSQL run:  alembic upgrade head
AUTO_CREATE_TABLES=false

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Comma-separated frontend origins (no "*" in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First admin account, created at startup if it does not exist (password is never overwritten later)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Model files: local directory or S3-compatible object storage
MODEL_STORAGE_BACKEND=local
# Defaults to <project>/models
MODEL_STORAGE_DIR=
S3_BUCKET=
S3_PREFIX=driftwear/models
S3_ENDPOINT_URL=
S3_REGION=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by boto3 from the environment

# Uploads
MAX_UPLOAD_MB=5
MAX_UPLOAD_ROWS=50000

# Simulation mode (synthetic replay, stored separately from live data)
SIMULATION_ENABLED=true
SIMULATION_TICK_SECONDS=1.0

# DDM | ADWIN | PageHinkley  (ADWIN and Page-Hinkley need River)
DEFAULT_DETECTOR=DDM

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
# Predictions + real-time events (POST /api/predict, /api/events/purchase) per user per minute
PREDICTION_RATE_LIMIT=120
# Most events / outcomes accepted in one POST /api/events/batch or /api/events/outcomes request
EVENT_BATCH_MAX=100
