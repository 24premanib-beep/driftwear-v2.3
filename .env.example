# docker compose settings. Copy to .env and fill in the two required values.

# REQUIRED: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# REQUIRED: at least 8 characters with letters and numbers
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# REQUIRED: database password (the database is only reachable inside the compose network)
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_USER=driftwear
POSTGRES_DB=driftwear

# Where browsers load the app from (the nginx frontend)
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080
API_PORT=8000

# local = Docker volume; s3 = S3-compatible storage (AWS S3, Supabase Storage, Cloudflare R2, MinIO)
MODEL_STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SIMULATION_ENABLED=true
DEFAULT_DETECTOR=DDM

# Rate limits: predictions + real-time events per user per minute; sign-in attempts per 5 minutes
PREDICTION_RATE_LIMIT=120
# Most events / outcomes accepted in one POST /api/events/batch or /api/events/outcomes request
EVENT_BATCH_MAX=100
LOGIN_RATE_LIMIT=10
